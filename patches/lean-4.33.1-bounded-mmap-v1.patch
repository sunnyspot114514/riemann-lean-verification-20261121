+/* Linux limits the number of VMAs per process. Keep the common, early imports
+   file-backed, but leave room for allocator segments, stacks, and other mappings.
+   This is a lifetime budget of file-mapping attempts, not a live-mapping count:
+   spending a slot on a failed or subsequently freed mapping is intentional.
+   The monotone counter needs no bookkeeping in serialized CompactedRegion data.
+   Setting LEAN_MAX_MMAP_REGIONS=0 exercises the existing relocation path. */
+bool take_compacted_region_mmap_slot() {
+#if defined(__linux__)
+    static std::atomic<size_t> remaining{[]() -> size_t {
+        char const * value = std::getenv("LEAN_MAX_MMAP_REGIONS");
+        if (!value) return 50000;
+        if (!*value) throw exception("LEAN_MAX_MMAP_REGIONS must be a non-negative integer");
+        size_t result = 0;
+        for (char const * p = value; *p; ++p) {
+            if (*p < '0' || *p > '9' ||
+                result > (std::numeric_limits<size_t>::max() - (*p - '0')) / 10) {
+                throw exception("LEAN_MAX_MMAP_REGIONS must be a non-negative integer");
+            }
+            result = result * 10 + (*p - '0');
+        }
+        return result;
+    }()};
+    size_t available = remaining.load(std::memory_order_relaxed);
+    while (available != 0) {
+        if (remaining.compare_exchange_weak(available, available - 1,
+                                            std::memory_order_relaxed)) {
+            return true;
+        }
+    }
+    return false;
+#else
+    return true;
+#endif
+}
+
+/* Use the allocator already bundled with Lean. Unlike one large glibc mmap per
+   buffer, ordinary regions share mimalloc segments. Huge allocations and other
+   users of mmap still consume VMAs; the file-map budget is not a process quota. */
+void * alloc_compacted_region_buffer(size_t size) {
+#if defined(__linux__) && defined(LEAN_MIMALLOC)
+    return mi_malloc(size);
+#else
+    return malloc(size);
+#endif
+}
+
+void free_compacted_region_buffer(char * buffer, size_t size, bool is_mmap) {
+    if (!buffer) return;
+    if (is_mmap) {
+#if defined(__has_feature)
+#if __has_feature(address_sanitizer)
+        __lsan_unregister_root_region(buffer, size);
+#endif
+#endif
+#ifdef LEAN_WINDOWS
+        lean_always_assert(UnmapViewOfFile(buffer));
+#else
+        lean_always_assert(munmap(buffer, size) == 0);
+#endif
+    } else {
+#if defined(__linux__) && defined(LEAN_MIMALLOC)
+        mi_free(buffer);
+#else
+        free_sized(buffer, size);
+#endif
+    }
+}
+
+struct compacted_region_buffer_deleter {
+    size_t size;
+    bool is_mmap;
+    void operator()(char * buffer) const {
+        free_compacted_region_buffer(buffer, size, is_mmap);
+    }
+};
